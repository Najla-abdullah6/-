        "!pip install streamlit\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import streamlit as st\n",
        "import datetime\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "\n",
        "\n",
        "# 1. إنشاء بيانات مبيعات وهمية للمخبز (Synthetic Data)\n",
        "np.random.seed(42)\n",
        "dates = pd.date_range(start=\"2025-01-01\", periods=365, freq=\"D\")\n",
        "products = [\"خبز توست\", \"كرواسون\", \"كيك شوكولاتة\", \"فطائر جبن\"]\n",
        "\n",
        "data = []\n",
        "for d in dates:\n",
        "    is_weekend = 1 if d.weekday() in [4, 5] else 0 # الجمعة والسبت\n",
        "    for p in products:\n",
        "        base_demand = {\"خبز توست\": 150, \"كرواسون\": 100, \"كيك شوكولاتة\": 40, \"فطائر جبن\": 80}[p]\n",
        "        # زيادة الطلب في عطلة نهاية الأسبوع\n",
        "        demand = base_demand + (is_weekend * 30) + np.random.randint(-15, 20)\n",
        "        data.append([d, p, d.weekday(), is_weekend, d.month, demand])\n",
        "\n",
        "df = pd.DataFrame(data, columns=[\"Date\", \"Product\", \"DayOfWeek\", \"IsWeekend\", \"Month\", \"Sales\"])\n",
        "\n",
        "# 2. تدريب نموذج الذكاء الاصطناعي (ML Model)\n",
        "models = {}\n",
        "for p in products:\n",
        "    p_df = df[df[\"Product\"] == p]\n",
        "    X = p_df[[\"DayOfWeek\", \"IsWeekend\", \"Month\"]]\n",
        "    y = p_df[\"Sales\"]\n",
        "\n",
        "    model = RandomForestRegressor(n_estimators=50, random_state=42)\n",
        "    model.fit(X, y)\n",
        "    models[p] = model\n",
        "\n",
        "# 3. واجهة التحكم (Streamlit Dashboard)\n",
        "st.title(\"🍞 نظام BakeryAI للتنبؤ بالإنتاج والمبيعات اليومية\")\n",
        "st.write(\"يقوم النظام بتحليل البيانات التاريخية للتنبؤ بالكمية المثالية المطلوب إنتاجها لتقليل الهدر.\")\n",
        "\n",
        "target_date = st.date_input(\"اختر التاريخ لمعرفة الكمية المقترحة للإنتاج:\", datetime.date.today())\n",
        "\n",
        "is_weekend_val = 1 if target_date.weekday() in [4, 5] else 0\n",
        "input_data = pd.DataFrame([[target_date.weekday(), is_weekend_val, target_date.month]],\n",
        "                          columns=[\"DayOfWeek\", \"IsWeekend\", \"Month\"])\n",
        "\n",
       print (f\"📊 الكميات الموصى بإنتاجها ليوم: {target_date.strftime('%Y-%m-%d')}\")\n",
        "\n",
        "results = []\n",
        "for p in products:\n",
        "    pred = models[p].predict(input_data)[0]\n",
        "    results.append({\"المنتج\": p, \"الكمية المقترحة (قطعة)\": int(np.round(pred))})\n",
        "\n",
        "res_df = pd.DataFrame(results)\n",
        "display(res_df)"
      ]
    }
